{
  "$defs": {
    "blocks": {
      "brief": {
        "additionalProperties": false,
        "properties": {
          "audience": {
            "description": "Who it is for.",
            "maxLength": 250,
            "type": "string"
          },
          "notes": {
            "description": "Points to cover, sources, tone, length.",
            "type": "string"
          },
          "topic": {
            "description": "What the piece is about, in one line.",
            "maxLength": 250,
            "type": "string"
          }
        },
        "required": [
          "topic"
        ],
        "type": "object"
      },
      "code": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "The code, verbatim.",
            "type": "string"
          },
          "language": {
            "description": "Fence language, e.g. python, bash, yaml.",
            "maxLength": 40,
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "type": "object"
      },
      "heading": {
        "additionalProperties": false,
        "properties": {
          "level": {
            "description": "Heading level, 2 to 6.",
            "enum": [
              "2",
              "3",
              "4",
              "5",
              "6"
            ],
            "type": "string"
          },
          "text": {
            "description": "The heading text, plain, without leading #.",
            "maxLength": 200,
            "type": "string"
          }
        },
        "required": [
          "level",
          "text"
        ],
        "type": "object"
      },
      "image": {
        "additionalProperties": false,
        "properties": {
          "alt": {
            "description": "Alternative text; empty only if decorative.",
            "maxLength": 250,
            "type": "string"
          },
          "caption": {
            "description": "Visible caption.",
            "maxLength": 250,
            "type": "string"
          },
          "image": {
            "description": "The id of an image in the image library.",
            "type": "integer"
          }
        },
        "required": [
          "image"
        ],
        "type": "object"
      },
      "letter": {
        "additionalProperties": false,
        "properties": {
          "alt": {
            "description": "Accessible description of the intended plate.",
            "maxLength": 250,
            "type": "string"
          },
          "image": {
            "description": "The drawn plate, once it exists.",
            "type": [
              "integer",
              "null"
            ]
          },
          "letter": {
            "description": "One capital letter, A to Z.",
            "pattern": "^[A-Z]$",
            "type": "string"
          },
          "subject": {
            "description": "A concrete, drawable scene with no text in it, for the art model.",
            "maxLength": 400,
            "type": "string"
          },
          "tagline": {
            "description": "The line a grown-up reads aloud.",
            "maxLength": 250,
            "type": "string"
          },
          "word": {
            "description": "The word the letter stands for.",
            "maxLength": 80,
            "type": "string"
          }
        },
        "required": [
          "letter",
          "word",
          "tagline"
        ],
        "type": "object"
      },
      "markdown": {
        "description": "A chunk of Markdown kept verbatim: paragraphs, lists, tables, Liquid tags, includes, raw HTML and [[wikilinks]] are all allowed and are never rewritten.",
        "type": "string"
      },
      "page_link": {
        "additionalProperties": false,
        "properties": {
          "page": {
            "description": "The id of the page to link to.",
            "type": "integer"
          },
          "text": {
            "description": "Link text; defaults to the page title.",
            "maxLength": 200,
            "type": "string"
          }
        },
        "required": [
          "page"
        ],
        "type": "object"
      },
      "paragraph": {
        "contentMediaType": "text/html",
        "description": "Rich text as Wagtail's HTML subset: <p>, <b>, <i>, <a href>, <ol>, <ul>, <li>, <code>.",
        "type": "string"
      },
      "quote": {
        "additionalProperties": false,
        "properties": {
          "attribution": {
            "description": "Who said it.",
            "maxLength": 200,
            "type": "string"
          },
          "text": {
            "description": "The quotation, plain text.",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "type": "object"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
