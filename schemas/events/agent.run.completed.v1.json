{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bamr87/zer0-CMS/blob/main/schemas/events/agent.run.completed.v1.json",
  "title": "agent.run.completed (v1)",
  "description": "An agent run reached a final state. Each plane publishes it for its own runs; trace ids join them.",
  "type": "object",
  "required": ["run_id", "agent", "status"],
  "properties": {
    "run_id": { "type": "integer", "minimum": 1 },
    "agent": { "type": "string" },
    "status": { "enum": ["succeeded", "failed", "refused", "cancelled"] },
    "trigger": { "type": "string" },
    "cost_usd": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" },
    "tokens": { "type": "integer", "minimum": 0 },
    "suggestions": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
