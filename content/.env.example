# The content plane's environment (config/settings/base.py reads every key).
# Copy to content/.env for local runs; compose sets these itself.
SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# SQLite by default; compose and CI use Postgres with pgvector.
DATABASE_URL=postgres://zer0:zer0@localhost:5432/zer0
REDIS_URL=redis://localhost:6379/0
# Models: recorded (fixtures, no network) | fake | litellm (needs `pip install litellm` and provider keys).
LLM_BACKEND=recorded
# ZER0_LLM_RECORD=1   # with litellm: also write every completion as a recording
# ANTHROPIC_API_KEY=  # read by LiteLLM when LLM_BACKEND=litellm
EMBEDDING_BACKEND=hashing
EMBEDDING_MODEL=hashing-256
EMBEDDING_DIMENSIONS=256
# Browser origins an MCP client may call /mcp/ from.
MCP_ALLOWED_ORIGINS=http://localhost:8000
