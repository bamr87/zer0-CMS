# The content plane's environment (config/settings/base.py reads every key).
# Copy to content/.env for local runs; compose sets these itself.
SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# SQLite by default; compose and CI use Postgres with pgvector.
DATABASE_URL=postgres://zer0:zer0@localhost:5432/zer0
REDIS_URL=redis://localhost:6379/0
# The tool-using agents' model: recorded (fixtures, no network) | fake | any provider in the
# registry — litellm, anthropic, openai (pip install -r requirements-providers.txt). The definitions'
# anthropic/… ids reach the anthropic adapter bare; claude_code has no tool calls, so it refuses them.
LLM_BACKEND=recorded
# ZER0_LLM_RECORD=1   # with a live provider: also write every completion as a recording

# ── The AI content layer (ai/README.md) ─────────────────────────────────────
# The provider assistants use when no provider row is the default:
# claude_code | anthropic | openai | litellm | fake | recorded
AI_DEFAULT_PROVIDER=claude_code
# Fernet keys for the provider credentials stored in the database, newest first
# (comma-separated); unset, the key derived from SECRET_KEY encrypts. The derived keys (and those of
# SECRET_KEY_FALLBACKS) always still decrypt, so setting this loses nothing: then run
# manage.py rotate_ai_credentials to move every credential to the first key.
# AI_CREDENTIAL_KEYS=
# What an adapter reads when its provider row holds no credential (never for a row with its own base URL):
# CLAUDE_CODE_OAUTH_TOKEN=   # claude_code (`claude setup-token`)
# ANTHROPIC_API_KEY=         # anthropic, claude_code, and LiteLLM's anthropic/* models
# OPENAI_API_KEY=            # openai, and LiteLLM's openai/* models
EMBEDDING_BACKEND=hashing
EMBEDDING_MODEL=hashing-256
EMBEDDING_DIMENSIONS=256
# Browser origins an MCP client may call /mcp/ from.
MCP_ALLOWED_ORIGINS=http://localhost:8000

# ── The ops baseline (ops/README.md) ───────────────────────────────────────
LOG_FORMAT=text            # json | text; production defaults to json
LOG_LEVEL=INFO
# Browser origins that may call /api/, /graphql/ and /mcp/ (comma-separated; never `*`).
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
# Requests per scope; empty turns a scope off. NUM_PROXIES keys the anonymous
# bucket on the client address behind that many proxies.
THROTTLE_ANON_RATE=120/min
THROTTLE_PRINCIPAL_RATE=600/min
# Per person: research captures, refetches, searches and feed reads (research/views.py).
THROTTLE_RESEARCH_FETCH_RATE=30/min
# NUM_PROXIES=1
# The docs UI at /api/v2/docs (on in development, off in production).
API_DOCS_ENABLED=true
# Error reporting: off until a DSN is set.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
# What /version reports; the image build sets them.
GIT_SHA=
BUILT_AT=
# The report-only CSP and Permissions-Policy have sensible defaults; override to tune.
# CSP_REPORT_ONLY=default-src 'self'; …
# CSP_REPORT_URI=
# PERMISSIONS_POLICY=camera=(), microphone=(), geolocation=(), payment=(), usb=()
