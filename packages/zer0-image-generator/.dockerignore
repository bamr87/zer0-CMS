# Build context is the repo root; keep it small and secret-free.

.git
.github
.claude
.sweep
.preview

# Bundler installs into a named volume / the image, never from the host tree.
# Exclude the local .bundle/config too: it pins path to vendor/bundle on the
# dev machine and would override the image's own bundle path if copied in.
web/vendor/bundle
web/node_modules
web/tmp
web/log
web/storage
web/.bundle
web/storage/*.sqlite3

# Never bake decryption keys into an image.
**/*.key
**/.env
**/.env.*

**/.DS_Store
**/*.gem
__pycache__
**/__pycache__
*.pyc
