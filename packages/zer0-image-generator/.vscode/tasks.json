// zer0-image-generator · .vscode/tasks.json — fleet-vscode/v1 · 2026-09-09. Convention + vocabulary: .vscode/README.md.
// macOS gotcha: the system Ruby 2.6 can gem build but cannot run the CLI or the smoke harness — the host tasks assume Homebrew Ruby first on PATH (export PATH="/opt/homebrew/opt/ruby/bin:$PATH").
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Serve",
      "detail": "Docker. The web app on http://localhost:3000 (SITES_DIR=.. mounts the sibling Jekyll sites at /sites). Runs until Stop.",
      "type": "shell",
      "command": "docker compose up --build",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "SITES_DIR": ".."
        }
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "owner": "serve",
        "pattern": {
          "regexp": "^(never-matches)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Listening on|Container \\S+\\s+Running"
        }
      }
    },
    {
      "label": "Stop",
      "detail": "Stops and removes the Docker stack (docker compose down).",
      "type": "shell",
      "command": "docker compose down",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build",
      "detail": "Host ruby. Builds the gem.",
      "type": "shell",
      "command": "gem build zer0-image-generator.gemspec",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Verify",
      "detail": "Host ruby + python. test.yml's gem-build job (syntax check, CLI tests, gem build) plus the engine port and Python oracle tests.",
      "type": "shell",
      "command": "for f in lib/zer0-image-generator.rb lib/zer0_image_generator/*.rb; do ruby -c \"$f\" >/dev/null || exit 1; done && ruby test/test_command.rb && for f in test/ruby/test_*.rb; do ruby -Ilib \"$f\" || exit 1; done && python3 test/test_preview_generator.py && gem build zer0-image-generator.gemspec",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Test: engine (ruby)",
      "detail": "Host ruby. The pure-Ruby port — byte-identity vs the Python oracle.",
      "type": "shell",
      "command": "for f in test/ruby/test_*.rb; do ruby -Ilib \"$f\" || exit 1; done",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Test: engine (python)",
      "detail": "Host python, zero network. The original engine's tests.",
      "type": "shell",
      "command": "python3 test/test_preview_generator.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Test: CLI",
      "detail": "Host ruby. The gem's CLI translation layer.",
      "type": "shell",
      "command": "ruby test/test_command.rb",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Test: web",
      "detail": "Host ruby + bundler. models, services, requests, jobs.",
      "type": "shell",
      "command": "bin/rails test",
      "options": {
        "cwd": "${workspaceFolder}/web"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Smoke",
      "detail": "Host. End-to-end: drives the real CLI against a throwaway copy of test/fixture-site with the free local provider — no keys, no network.",
      "type": "shell",
      "command": ".claude/skills/run-zer0-image-generator/smoke.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Claude: session",
      "detail": "Interactive Claude Code in this repo with its .claude/agents + skills, on your logged-in credentials. House rules still apply: branch from main, open a PR, a human merges.",
      "type": "shell",
      "command": "claude",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true
      }
    }
  ]
}
