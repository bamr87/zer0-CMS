<% content_for :title, "Image forge" %>
<% content_for :topbar_actions do %>
  <%= link_to "＋ New image", new_composition_path, class: "btn primary" %>
<% end %>

<div class="page-head">
  <div>
    <h1>Image forge</h1>
    <div class="sub">Create images with Claude art direction, then process further with OpenAI. Not tied to a Jekyll site — a standalone workspace per image.</div>
  </div>
</div>

<% if @compositions.any? %>
  <div class="grid cols-3">
    <% @compositions.each do |composition| %>
      <% img = composition.latest_image %>
      <%= link_to composition, class: "card pad-0", style: "display:block; color:inherit; text-decoration:none;" do %>
        <div class="preview-frame" style="min-height:130px; aspect-ratio:3/2;">
          <% if img&.exists? %>
            <img src="<%= file_path(path: img.pathname.realpath.to_s.sub(%r{\A/}, "")) %>" loading="lazy" alt="<%= composition.title %>">
          <% else %>
            <span class="faint"><%= composition.working? ? "working…" : "no image" %></span>
          <% end %>
        </div>
        <div style="padding:.6rem .8rem;">
          <div style="font-weight:600; font-size:.9rem;"><%= composition.title %></div>
          <div class="faint mono" style="font-size:.74rem;">
            <%= composition.provider %> · <%= pluralize(composition.images.count, "version") %> · <%= composition.status %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="empty">
    <div class="big">✧</div>
    <p>No images yet.</p>
    <%= link_to "＋ Create your first image", new_composition_path, class: "btn primary" %>
  </div>
<% end %>
