<% content_for :title, "SVG Studio" %>
<% content_for :topbar_actions do %>
  <%= link_to "Library", library_entries_path, class: "btn" %>
  <%= link_to "＋ New render", new_studio_render_path, class: "btn primary" %>
<% end %>
<div class="page-head">
  <div><h1>SVG Studio</h1><div class="sub">Drive the parametric generators, render live, and keep the good ones. Every piece is deterministic — generator + params + seed reproduces it exactly.</div></div>
</div>

<h2 style="margin-bottom:.7rem;">Generators</h2>
<div class="grid cols-3" style="margin-bottom:1.6rem;">
  <% @generators.each do |g| %>
    <%= link_to new_studio_render_path(generator: g.key), class: "card", style: "display:block; text-decoration:none; color:inherit;" do %>
      <h3 style="margin-bottom:.3rem;"><%= g.label %></h3>
      <p class="dim" style="font-size:.85rem; margin:0;"><%= g.blurb %></p>
    <% end %>
  <% end %>
</div>

<% if @favorites.any? %>
  <h2 style="margin-bottom:.7rem;">Favorites</h2>
  <div class="grid cols-4" style="margin-bottom:1.6rem;">
    <% @favorites.each do |render| %>
      <%= render_card(render) %>
    <% end %>
  </div>
<% end %>

<h2 style="margin-bottom:.7rem;">Recent renders</h2>
<% if @renders.any? %>
  <div class="grid cols-4">
    <% @renders.each do |render| %>
      <%= render_card(render) %>
    <% end %>
  </div>
<% else %>
  <div class="empty"><div class="big">✦</div>No saved renders yet. Pick a generator above to start.</div>
<% end %>
