<turbo-frame id="studio-preview">
  <div class="preview-frame" style="min-height:200px;">
    <%== studio_scaled_svg(svg) %>
  </div>
  <div class="btn-row" style="margin-top:.7rem;">
    <span class="badge <%= lint["clean"] ? "ok" : "warn" %>">
      <span class="dot"></span><%= lint["clean"] ? "lint clean" : "#{lint["errors"].size} err / #{lint["warnings"].size} warn" %>
    </span>
    <span class="faint mono" style="font-size:.78rem;">seed <%= meta[:seed] %> · <%= number_with_delimiter(svg.bytesize) %> B</span>
  </div>
  <% if lint["errors"].any? || lint["warnings"].any? %>
    <ul class="faint" style="font-size:.78rem; margin:.5rem 0 0; padding-left:1.1rem;">
      <% lint["errors"].each do |e| %><li style="color:var(--err)"><%= e %></li><% end %>
      <% lint["warnings"].each do |w| %><li style="color:var(--warn)"><%= w %></li><% end %>
    </ul>
  <% end %>
</turbo-frame>
