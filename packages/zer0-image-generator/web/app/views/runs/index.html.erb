<% content_for :title, @site ? "Runs — #{@site.name}" : "All runs" %>
<% content_for :crumbs do %>
  <% if @site %><%= link_to "Sites", sites_path %> / <%= link_to @site.name, @site %> / Runs<% else %>Runs<% end %>
<% end %>
<% content_for :topbar_actions do %>
  <% if @site %>
    <%= link_to "＋ New run", new_site_run_path(@site), class: "btn primary" %>
  <% elsif @nav_sites&.any? %>
    <label class="run-picker">
      <span class="faint">Start a run on</span>
      <select onchange="if(this.value) location=this.value">
        <option value="">choose a site…</option>
        <% @nav_sites.each do |site| %>
          <option value="<%= new_site_run_path(site) %>"><%= site.name %></option>
        <% end %>
      </select>
    </label>
  <% end %>
<% end %>

<div class="page-head"><h1><%= @site ? "#{@site.name} runs" : "All runs" %></h1></div>
<% if @site %><%= render "shared/site_nav", site: @site %><% end %>

<% run_index = ->(kind: nil, status: nil) {
     opts = { kind: kind, status: status }.compact_blank
     @site ? site_runs_path(@site, opts) : runs_path(opts)
   } %>
<div class="chip-row" style="margin-bottom:1rem;">
  <%= link_to "all kinds", run_index.(status: @status.presence), class: "badge #{@kind.blank? ? "ok" : ""}" %>
  <% Run::KINDS.each do |kind| %>
    <%= link_to kind, run_index.(kind: kind, status: @status.presence), class: "badge #{@kind == kind ? "ok" : ""}" %>
  <% end %>
</div>
<div class="chip-row" style="margin-bottom:1.2rem;">
  <%= link_to "all statuses", run_index.(kind: @kind.presence), class: "badge #{@status.blank? ? "ok" : ""}" %>
  <% Run::STATUSES.each do |status| %>
    <%= link_to status, run_index.(kind: @kind.presence, status: status), class: "badge #{@status == status ? "ok" : ""}" %>
  <% end %>
</div>

<% if @runs.any? %>
  <div class="card pad-0">
    <table class="list">
      <thead><tr><th>#</th><th>Kind</th><th>Status</th><% unless @site %><th>Site</th><% end %><th>Stats</th><th>When</th></tr></thead>
      <tbody>
        <% @runs.each do |run| %>
          <tr>
            <td><%= link_to "##{run.id}", run %></td>
            <td class="mono"><%= run.kind %></td>
            <td><%= render "shared/run_status", run: run %></td>
            <% unless @site %><td><%= run.site ? link_to(run.site.name, run.site) : "—" %></td><% end %>
            <td class="faint mono" style="font-size:.82rem;">
              <% if run.stats.present? %><%= run.stats.values_at("generated", "skipped", "errors").compact.join(" / ") %> <span class="faint">g/s/e</span><% end %>
            </td>
            <td class="faint nowrap"><%= time_ago_in_words(run.created_at) %> ago</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="empty"><div class="big">▶</div>No runs yet<%= " for this filter" if @kind.present? || @status.present? %>.</div>
<% end %>
