<%# Re-rendered live via Turbo when the run finishes (see GenerationJob). %>
<div class="page-head" style="margin-bottom:0;">
  <div>
    <h1 style="display:flex; align-items:center; gap:.6rem;">
      Run #<%= run.id %> · <span class="mono" style="font-size:1rem;"><%= run.kind %></span>
      <%= render "shared/run_status", run: run %>
    </h1>
    <div class="sub">
      <% if run.site %><%= link_to run.site.name, run.site %> · <% end %>
      <% if run.started_at %>started <%= time_ago_in_words(run.started_at) %> ago<% else %>queued<% end %>
      <% if run.duration %> · took <%= distance_of_time_in_words(0, run.duration) %><% end %>
    </div>
  </div>
  <div class="btn-row">
    <% unless run.finished? %>
      <%= button_to "Cancel run", cancel_run_path(run), class: "btn danger", form: { data: { turbo_confirm: "Cancel this run?" } } %>
    <% end %>
    <% if run.site %>
      <%= link_to "New run", new_site_run_path(run.site), class: "btn" %>
    <% end %>
  </div>
</div>

<% if run.finished? && run.stats.present? %>
  <div class="btn-row" style="margin-top:1rem;">
    <% { "processed" => "processed", "generated" => "generated", "enhanced" => "enhanced", "skipped" => "skipped", "errors" => "errors" }.each do |key, label| %>
      <% val = run.stats[key] %>
      <% next if val.nil? %>
      <span class="badge <%= key == "errors" && val.to_i.positive? ? "err" : "" %>"><%= val %> <%= label %></span>
    <% end %>
  </div>
<% end %>

<% if run.error.present? %>
  <div class="flash alert" style="margin-top:1rem;"><%= run.error %></div>
<% end %>
