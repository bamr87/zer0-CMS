<% content_for :title, "New run — #{@site.name}" %>
<% content_for :crumbs do %><%= link_to "Sites", sites_path %> / <%= link_to @site.name, @site %> / New run<% end %>

<div class="page-head">
  <div><h1>Generate previews</h1><div class="sub"><span class="mono"><%= @site.path %></span></div></div>
</div>

<% if @scan %>
  <div class="grid cols-3" style="margin-bottom:1.3rem;">
    <div class="card stat"><span class="num"><%= @scan.total %></span><span class="lbl">Content files</span></div>
    <div class="card stat"><span class="num" style="color:var(--warn)"><%= @scan.missing %></span><span class="lbl">Missing a preview</span></div>
    <div class="card stat"><span class="num" style="color:var(--ok)"><%= @scan.present %></span><span class="lbl">Already have one</span></div>
  </div>
<% end %>

<%= form_with url: site_runs_path(@site), method: :post do |f| %>
  <div class="grid cols-2">
    <div class="card">
      <h2>Mode</h2>
      <% [
           ["dry_run",      "Dry run",       "Show what would be generated. Writes nothing — the safe default."],
           ["list_missing", "List missing",  "Only report files without a valid preview."],
           ["generate",     "Generate",      "Produce images and wire them into front matter. Costs money unless provider is local."],
           ["enhance",      "Enhance",       "Re-run existing images through the OpenAI edit endpoint."],
         ].each do |value, label, blurb| %>
        <label class="field" style="display:flex; gap:.6rem; align-items:flex-start; cursor:pointer; margin-bottom:.7rem;">
          <input type="radio" name="run[kind]" value="<%= value %>" style="width:auto; margin-top:.3rem;" <%= "checked" if @run.kind == value %>>
          <span>
            <strong><%= label %></strong>
            <div class="hint" style="margin-top:0;"><%= blurb %></div>
          </span>
        </label>
      <% end %>
    </div>

    <div class="card">
      <h2>Scope & renderer</h2>
      <div class="field">
        <label>Collection</label>
        <select name="run[collection]">
          <option value="all">All configured collections</option>
          <% (@scan&.collections || []).each do |c| %>
            <option value="<%= c %>"><%= c %></option>
          <% end %>
        </select>
      </div>
      <div class="field">
        <label>Single file (optional)</label>
        <input type="text" name="run[file]" placeholder="_posts/2026-01-01-hello.md" class="mono">
        <div class="hint">Overrides collection. Path relative to the site root.</div>
      </div>
      <div class="field">
        <label>Provider</label>
        <select name="run[provider]">
          <option value="">config default</option>
          <% EngineBridge.provider_names.each do |name| %>
            <% ok = @available_providers.include?(name) %>
            <option value="<%= name %>"><%= name %><%= ok ? "" : " (no key)" %></option>
          <% end %>
        </select>
        <div class="hint"><span class="mono">local</span> needs no key and is deterministic. Others bill per image.</div>
      </div>
      <div class="field-row">
        <div class="field"><label>Parallel workers</label><input type="number" name="run[parallel]" min="1" max="12" placeholder="4"></div>
        <div class="field"><label>Batch limit</label><input type="number" name="run[batch]" min="0" placeholder="all"></div>
      </div>
    </div>
  </div>

  <div class="card" style="margin-top:1rem;">
    <details>
      <summary style="cursor:pointer; font-weight:600;">Advanced options</summary>
      <div class="grid cols-2" style="margin-top:1rem;">
        <div>
          <div class="field"><label>Prompt engine</label>
            <select name="run[prompt_engine]"><option value="">config default</option><option value="claude">claude</option><option value="template">template</option></select>
          </div>
          <div class="field"><label>Review engine</label>
            <select name="run[review]"><option value="">config default</option><option value="claude">claude</option><option value="none">none</option></select>
          </div>
          <div class="field"><label>Rasterizer (local provider)</label>
            <select name="run[rasterizer]"><% %w[auto rsvg inkscape magick playwright none].each do |r| %><option value="<%= r %>"><%= r %></option><% end %></select>
          </div>
        </div>
        <div>
          <div class="field"><label>Style override</label><textarea name="run[style]" rows="2" placeholder="retro pixel art, 8-bit…"></textarea></div>
          <label class="field" style="display:flex; gap:.5rem; align-items:center;"><input type="checkbox" name="run[force]" value="1" style="width:auto;"> Force — regenerate even where a preview exists</label>
          <label class="field" style="display:flex; gap:.5rem; align-items:center;"><input type="checkbox" name="run[verbose]" value="1" style="width:auto;"> Verbose logging</label>
        </div>
      </div>
    </details>
  </div>

  <div class="btn-row" style="margin-top:1.2rem;">
    <%= f.submit "Queue run", class: "btn primary" %>
    <%= link_to "Cancel", @site, class: "btn" %>
  </div>
<% end %>
