<% content_for :title, "Library" %>
<% content_for :topbar_actions do %>
  <%= link_to "FreeSVG search", freesvg_search_path, class: "btn" %>
  <%= button_to "Sync from MANIFEST", sync_library_entries_path, class: "btn" %>
<% end %>

<div class="page-head">
  <div><h1>Example library</h1><div class="sub">Curated SVGs with tracked provenance and licenses. Sourced pieces carry a source URL and license; first-party pieces are MIT. Promote new ones from <%= link_to "FreeSVG.org", freesvg_search_path %>.</div></div>
</div>

<% if @error %><div class="flash alert"><%= @error %></div><% end %>

<%= form_with url: library_entries_path, method: :get, class: "filter-bar" do %>
  <%= hidden_field_tag :tag, params[:tag] if params[:tag].present? %>
  <%= search_field_tag :q, @q, placeholder: "Search title, file, tags…" %>
  <%= submit_tag "Search", class: "btn sm" %>
  <% if @q.present? || params[:tag].present? %><%= link_to "Clear", library_entries_path, class: "btn sm" %><% end %>
<% end %>

<% if @tags.any? %>
  <div class="chip-row">
    <%= link_to "all", library_entries_path(q: @q), class: "badge #{params[:tag].blank? ? "ok" : ""}" %>
    <% @tags.each do |tag, n| %>
      <%= link_to "#{tag} (#{n})", library_entries_path(tag: tag, q: @q), class: "badge #{params[:tag] == tag ? "ok" : ""}" %>
    <% end %>
  </div>
<% end %>

<% if @entries.any? %>
  <div class="grid cols-4">
    <% @entries.each do |entry| %>
      <%= link_to library_entry_path(entry), class: "card pad-0 feature", style: "display:block;" do %>
        <div class="preview-frame" style="min-height:120px; aspect-ratio:3/2;">
          <% file = Rails.application.config.repo_root.join(entry.file) %>
          <% url = disk_file_url(file) %>
          <% if url %><img src="<%= url %>" loading="lazy" alt="<%= entry.title %>"><% else %><span class="faint">missing</span><% end %>
        </div>
        <div style="padding:.5rem .7rem;">
          <div style="font-weight:600; font-size:.85rem;"><%= entry.title %></div>
          <div class="faint mono" style="font-size:.72rem;"><%= entry.license %><%= entry.first_party? ? "" : " · sourced" %></div>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="empty"><div class="big">▦</div>No library entries. <%= button_to "Sync from MANIFEST.json", sync_library_entries_path, class: "btn primary" %> or <%= link_to "search FreeSVG", freesvg_search_path %>.</div>
<% end %>
