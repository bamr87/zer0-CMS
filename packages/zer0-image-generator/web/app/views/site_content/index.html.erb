<% content_for :title, "Content — #{@site.name}" %>
<% content_for :crumbs do %><%= link_to "Sites", sites_path %> / <%= link_to @site.name, @site %> / Content<% end %>
<% content_for :topbar_actions do %><%= link_to "＋ New run", new_site_run_path(@site), class: "btn primary" %><% end %>

<div class="page-head"><h1>Content</h1></div>
<%= render "shared/site_nav", site: @site %>

<% if @scan_error %>
  <div class="flash alert"><%= @scan_error %></div>
<% else %>
  <div class="tab-row">
    <%= link_to "All (#{@scan.total})", site_content_index_path(@site, q: @q, collection: @collection), class: @filter.blank? ? "active" : "" %>
    <%= link_to "Missing (#{@scan.missing})", site_content_index_path(@site, filter: "missing", q: @q, collection: @collection), class: @filter == "missing" ? "active" : "" %>
    <%= link_to "Have preview (#{@scan.present})", site_content_index_path(@site, filter: "present", q: @q, collection: @collection), class: @filter == "present" ? "active" : "" %>
  </div>

  <% if @scan.collections.size > 1 %>
    <div class="chip-row">
      <%= link_to "all collections", site_content_index_path(@site, filter: @filter, q: @q), class: "badge #{@collection.blank? ? "ok" : ""}" %>
      <% @scan.collections.each do |name| %>
        <%= link_to name, site_content_index_path(@site, filter: @filter, collection: name, q: @q), class: "badge #{@collection == name ? "ok" : ""}" %>
      <% end %>
    </div>
  <% end %>

  <%= form_with url: site_content_index_path(@site), method: :get, class: "filter-bar" do %>
    <%= hidden_field_tag :filter, @filter if @filter.present? %>
    <%= hidden_field_tag :collection, @collection if @collection.present? %>
    <%= search_field_tag :q, @q, placeholder: "Search title or path…" %>
    <%= submit_tag "Search", class: "btn sm" %>
  <% end %>

  <% if @entries.any? %>
    <div class="card pad-0">
      <table class="list">
        <thead><tr><th></th><th>Title</th><th>Collection</th><th>Status</th><th></th></tr></thead>
        <tbody>
          <% @entries.each do |entry| %>
            <% item_url = item_site_content_index_path(@site, file: entry.relative) %>
            <tr>
              <td style="width:88px;">
                <% url = preview_image_url(entry) %>
                <% if url %>
                  <%= link_to item_url do %>
                    <span class="preview-frame thumb"><img src="<%= url %>" alt="" loading="lazy"></span>
                  <% end %>
                <% else %>
                  <span class="preview-frame thumb faint">—</span>
                <% end %>
              </td>
              <td>
                <%= link_to entry.title, item_url %>
                <div class="faint mono" style="font-size:.76rem;"><%= entry.relative %></div>
              </td>
              <td class="mono faint"><%= entry.collection %></td>
              <td>
                <% if entry.exists %><span class="badge ok"><span class="dot"></span>ok</span>
                <% elsif entry.preview %><span class="badge err"><span class="dot"></span>broken link</span>
                <% else %><span class="badge warn"><span class="dot"></span>none</span><% end %>
              </td>
              <td class="right nowrap">
                <%= link_to "Open", item_url, class: "btn sm" %>
                <%= link_to "Generate", new_site_run_path(@site, kind: "generate", file: entry.relative), class: "btn sm #{entry.exists ? "" : "primary"}" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <p class="hint" style="margin-top:.8rem;"><%= @entries.size %> shown<%= " of #{@scan.total}" if @entries.size != @scan.total %>.</p>
  <% else %>
    <div class="empty"><div class="big">▤</div>No files match this filter.</div>
  <% end %>
<% end %>
