<% content_for :title, @entry.title %>
<% content_for :crumbs do %><%= link_to "Sites", sites_path %> / <%= link_to @site.name, @site %> / <%= link_to "Content", site_content_index_path(@site) %> / <%= @entry.title %><% end %>
<% content_for :topbar_actions do %>
  <%= link_to "Generate", new_site_run_path(@site, kind: "generate", file: @entry.relative), class: "btn primary" %>
<% end %>

<div class="page-head">
  <div>
    <h1><%= @entry.title %></h1>
    <div class="sub mono"><%= @entry.relative %></div>
  </div>
</div>
<%= render "shared/site_nav", site: @site %>

<div class="grid cols-2" style="align-items:start;">
  <div class="card">
    <h2>Preview</h2>
    <% url = preview_image_url(@entry) %>
    <% if url %>
      <div class="preview-frame" style="min-height:280px;">
        <img src="<%= url %>" alt="<%= @entry.title %>">
      </div>
      <div class="btn-row" style="margin-top:.8rem;">
        <%= link_to "Open original", url, class: "btn sm", target: "_blank" %>
      </div>
    <% elsif @entry.exists && @entry.remote? %>
      <div class="empty">Remote preview — <%= link_to @entry.preview, @entry.preview, target: "_blank" %></div>
    <% elsif @entry.preview %>
      <div class="flash alert">Front matter points at <span class="mono"><%= @entry.preview %></span> but that file is not on disk.</div>
    <% else %>
      <div class="empty"><div class="big">▤</div>No preview yet. <%= link_to "Generate one", new_site_run_path(@site, kind: "generate", file: @entry.relative) %>.</div>
    <% end %>
  </div>
  <div class="card">
    <h2>Front matter</h2>
    <table class="list">
      <tbody>
        <tr><td class="dim">Collection</td><td class="mono"><%= @entry.collection %></td></tr>
        <tr><td class="dim">Preview key</td><td class="mono" style="word-break:break-all;"><%= @entry.preview.presence || "—" %></td></tr>
        <tr><td class="dim">On disk</td><td class="mono" style="word-break:break-all;"><%= @entry.disk_path.presence || "—" %></td></tr>
        <tr><td class="dim">Status</td>
          <td>
            <% if @entry.exists %><span class="badge ok"><span class="dot"></span>ok</span>
            <% elsif @entry.preview %><span class="badge err"><span class="dot"></span>broken link</span>
            <% else %><span class="badge warn"><span class="dot"></span>none</span><% end %>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
