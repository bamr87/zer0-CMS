<%= form_with model: credential do |f| %>
  <% if credential.errors.any? %>
    <div class="flash alert">
      <ul style="margin:0;"><% credential.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
    </div>
  <% end %>
  <div class="card">
    <div class="field">
      <%= f.label :provider %>
      <% if credential.new_record? %>
        <%= f.select :provider, Credential::PROVIDERS.map { |p| [Credential::LABELS[p] || p, p] }, {}, { disabled: params[:provider].present? } %>
        <%= f.hidden_field :provider if params[:provider].present? %>
      <% else %>
        <input type="text" value="<%= credential.provider %>" disabled>
        <%= f.hidden_field :provider %>
      <% end %>
    </div>
    <div class="field">
      <%= f.label :api_key, "API key" %>
      <%= f.password_field :api_key, placeholder: credential.new_record? ? "sk-…" : "•••••• (leave to replace)", autocomplete: "off" %>
      <div class="hint">Stored encrypted with ActiveRecord::Encryption. Injected as <span class="mono"><%= Credential::ENV_VARS[credential.provider] || "the provider's env var" %></span> at run time.</div>
    </div>
    <div class="field">
      <%= f.label :label, "Label (optional)" %>
      <%= f.text_field :label, placeholder: "personal / work account" %>
    </div>
    <div class="btn-row">
      <%= f.submit "Save key", class: "btn primary" %>
      <%= link_to "Cancel", credentials_path, class: "btn" %>
    </div>
  </div>
<% end %>
