<% content_for :title, "Credentials" %>
<div class="page-head">
  <div><h1>Credentials</h1><div class="sub">Keys and tokens are encrypted at rest and injected into a run's environment only while it executes.</div></div>
</div>

<% env = AiEnv.snapshot %>
<div class="card" style="margin-bottom:1.2rem;">
  <div class="btn-row" style="justify-content:space-between;">
    <div>
      <strong>Claude art direction</strong>
      <div class="hint" style="margin-top:.2rem;">
        <% if Credential.claude_available?(env) %>
          <span class="badge ok" style="margin-right:.4rem;"><span class="dot"></span>available</span> via <%= Credential.claude_source(env) %>
        <% else %>
          <span class="badge warn"><span class="dot"></span>not configured</span> — the analyze/review stages will fall back to a template prompt
        <% end %>
      </div>
    </div>
    <% unless Credential.usable.exists?(provider: "claude_oauth") %>
      <%= link_to "Add Claude Code OAuth token", new_credential_path(provider: "claude_oauth"), class: "btn sm primary" %>
    <% end %>
  </div>
</div>

<div class="card" style="margin-bottom:1.2rem;">
  <div class="btn-row" style="justify-content:space-between;">
    <div>
      <strong>xAI Grok renderer</strong>
      <div class="hint" style="margin-top:.2rem;">
        <% if (xai_source = Credential.xai_source(env)) %>
          <span class="badge ok" style="margin-right:.4rem;"><span class="dot"></span>available</span> via <%= xai_source %>
        <% else %>
          <span class="badge warn"><span class="dot"></span>not configured</span> — add a Grok OAuth token or an xAI API key to render with grok-2-image and to run Grok art direction / review
        <% end %>
      </div>
    </div>
    <% unless Credential.usable.exists?(provider: "xai_oauth") %>
      <%= link_to "Add Grok OAuth token", new_credential_path(provider: "xai_oauth"), class: "btn sm primary" %>
    <% end %>
  </div>
</div>

<div class="card pad-0">
  <table class="list">
    <thead><tr><th>Provider</th><th>Role</th><th>Key</th><th>Source</th><th></th></tr></thead>
    <tbody>
      <% @rows.each do |row| %>
        <% cred = row[:credential] %>
        <tr>
          <td><strong><%= Credential::LABELS[row[:provider]]&.split(" (")&.first || row[:provider] %></strong>
            <div class="faint mono" style="font-size:.72rem;"><%= Credential::ENV_VARS[row[:provider]] %></div>
          </td>
          <td class="faint"><%= Credential.role_label(row[:provider]) %></td>
          <td class="mono">
            <% if cred %><%= cred.masked %>
            <% elsif row[:from_env] %><span class="dim">set via environment</span>
            <% else %><span class="faint">— not set —</span><% end %>
          </td>
          <td>
            <% if cred %><span class="badge ok"><span class="dot"></span>stored</span>
            <% elsif row[:from_env] %><span class="badge"><span class="dot"></span>env</span>
            <% else %><span class="badge">missing</span><% end %>
          </td>
          <td class="right nowrap">
            <% if cred %>
              <%= link_to "Edit", edit_credential_path(cred), class: "btn sm" %>
              <%= button_to "Remove", cred, method: :delete, class: "btn sm danger", form: { data: { turbo_confirm: "Remove the #{cred.provider} key?" } } %>
            <% else %>
              <%= link_to "Add", new_credential_path(provider: row[:provider]), class: "btn sm primary" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<p class="hint" style="margin-top:1rem;">
  A value set via the environment (e.g. exported into the container) takes effect without being stored here. Stored entries fill a slot the environment left empty. Claude tries its tokens in order: OAuth token, then auth token, then API key. xAI does the same: the Grok OAuth token first, then the API key — which is also the automatic fallback if the OAuth token is expired or rejected mid-run.
</p>
