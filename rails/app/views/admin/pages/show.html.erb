<% content_for(:header_last) do %>
  <div class="btn-row">
    <%= link_to "Open site", admin_site_path(page.resource.site), class: "button button--alt" %>
    <%= button_to "Duplicate as draft", duplicate_admin_page_path(page.resource), class: "button button--alt" %>
  </div>
<% end %>
<% content_for(:before_main) do %>
  <p class="mono faint"><%= page.resource.relative %></p>
<% end %>
<%= render template: "administrate/application/show", locals: local_assigns %>
