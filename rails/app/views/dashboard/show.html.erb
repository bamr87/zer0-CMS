<% content_for :title, "Dashboard" %>
<% content_for :topbar_actions do %>
  <%= link_to "＋ Register site", new_site_path, class: "btn primary" %>
<% end %>

<div class="page-head">
  <div>
    <h1>Dashboard</h1>
    <div class="sub">Fleet CMS for zer0-themed Jekyll sites. The VS Code extension still edits in the editor; this is the platform console.</div>
  </div>
</div>

<div class="grid cols-3" style="margin-bottom:1.4rem;">
  <%= link_to sites_path, class: "card stat" do %>
    <span class="num"><%= @sites.size %></span><span class="lbl">Registered sites</span>
  <% end %>
  <%= link_to sites_path, class: "card stat" do %>
    <span class="num"><%= @unregistered.size %></span><span class="lbl">Unregistered roots</span>
  <% end %>
  <%= link_to new_abc_book_path, class: "card stat" do %>
    <span class="num" style="font-size:1.2rem;">ABC</span><span class="lbl">Book wizard</span>
  <% end %>
</div>

<h2 style="margin-bottom:.7rem;">Platform</h2>
<div class="grid cols-3" style="margin-bottom:1.6rem;">
  <%= link_to sites_path, class: "card feature" do %>
    <h3>Sites</h3>
    <p>Register Jekyll roots under <span class="mono">/sites</span>, scan collections, edit front matter in place.</p>
    <span class="badge"><%= @sites.size %> registered</span>
  <% end %>
  <%= link_to search_path, class: "card feature" do %>
    <h3>Search</h3>
    <p>Find a post by title, path, author, or tag across every registered site.</p>
    <span class="badge">fleet</span>
  <% end %>
  <%= link_to new_abc_book_path, class: "card feature" do %>
    <h3>ABC books</h3>
    <p>Generate a themed alphabet book and export it as a drsai / zer0-mistakes board book.</p>
    <span class="badge">wizard</span>
  <% end %>
  <div class="card feature">
    <h3>VS Code extension</h3>
    <p>Keep using the panel and dashboard inside VS Code for day-to-day edits. Same files, same front matter.</p>
    <span class="badge">src/</span>
  </div>
</div>

<div class="card">
  <div class="page-head" style="margin-bottom:.8rem;">
    <h2 style="margin:0;">Sites</h2>
    <%= link_to "All", sites_path, class: "btn sm" %>
  </div>
  <% if @sites.any? %>
    <table class="list">
      <tbody>
        <% @sites.each do |site| %>
          <tr>
            <td><%= link_to site.name, site %></td>
            <td class="mono faint"><%= site.path %></td>
            <td class="mono faint"><%= site.source_subdir.presence || "—" %></td>
            <td class="right"><%= link_to "Content", site_pages_path(site), class: "btn sm" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="empty">
      <div class="big">▤</div>
      No sites yet.
      <% if @unregistered.any? %>
        <%= button_to "Register #{@unregistered.size} Jekyll root#{'s' if @unregistered.size != 1} under /sites", import_discovered_sites_path, class: "btn primary" %>
      <% else %>
        <%= link_to "Register a site", new_site_path, class: "btn primary" %>
      <% end %>
    </div>
  <% end %>
</div>
