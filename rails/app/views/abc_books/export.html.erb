<% content_for :title, "Exported — #{@spec.title}" %>
<header class="main-content__header">
  <h1 class="main-content__page-title">Exported — <%= @spec.title %></h1>
  <%= link_to "← Make another book", new_abc_book_path, class: "button button--alt" %>
</header>

<section class="main-content__body">
  <p>Wrote the book bundle into <code><%= @target %></code>:</p>
  <ul>
    <li><code><%= @result.book_path %></code></li>
    <li><code><%= @result.spec_path %></code></li>
  </ul>
  <p><strong><%= @result.planned_images.length %></strong> illustration(s) still to render.</p>
  <p class="faint">Render them from the target repo:</p>
  <pre>python3 tools/generate_illustrations.py --book <%= @spec.slug %> --dry-run
python3 tools/generate_illustrations.py --book <%= @spec.slug %></pre>
</section>
