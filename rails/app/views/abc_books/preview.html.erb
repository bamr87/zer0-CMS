<% content_for :title, "Preview — #{@spec.title}" %>
<header class="main-content__header">
  <div>
    <h1 class="main-content__page-title">Preview — <%= @spec.title %></h1>
    <div class="sub"><%= @spec.subtitle %> · <%= @spec.alphabet.length %> letters · art style <code><%= @spec.art_style %></code> · nothing was written.</div>
  </div>
  <%= link_to "← Back to the wizard", new_abc_book_path, class: "button button--alt" %>
</header>

<section class="main-content__body">
  <pre class="config"><%= @markdown %></pre>
</section>

<p class="faint">Happy with it? Go back, choose an export target and press <strong>Export</strong> to write <code>pages/_books/<%= @spec.slug %>/index.md</code>.</p>
