<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>zer0-CMS — ABC Book Wizard</title>
    <%= csrf_meta_tags %>
    <style>
      :root { --ink:#1d2b3a; --accent:#2b7de9; --bg:#f6f8fb; }
      body { font: 16px/1.5 system-ui, sans-serif; color: var(--ink); background: var(--bg); margin: 0; }
      main { max-width: 720px; margin: 2rem auto; padding: 0 1rem; }
      h1 { font-size: 1.6rem; } label { display:block; font-weight:600; margin:.8rem 0 .2rem; }
      input, select { width:100%; padding:.5rem; border:1px solid #cdd6e0; border-radius:6px; font:inherit; }
      .row { display:grid; grid-template-columns:1fr 1fr; gap:1rem; }
      button { background:var(--accent); color:#fff; border:0; padding:.6rem 1.1rem; border-radius:6px; font:inherit; cursor:pointer; }
      button.ghost { background:#fff; color:var(--accent); border:1px solid var(--accent); }
      .alert { background:#fdecea; color:#8a1c14; padding:.7rem 1rem; border-radius:6px; }
      pre { background:#0f1720; color:#e6edf3; padding:1rem; border-radius:8px; overflow:auto; max-height:60vh; }
      .card { background:#fff; border:1px solid #e2e8f0; border-radius:10px; padding:1.2rem 1.4rem; }
      .muted { color:#5b6b7c; font-size:.9rem; }
    </style>
  </head>
  <body>
    <main>
      <% if flash[:alert] %><p class="alert"><%= flash[:alert] %></p><% end %>
      <%= yield %>
    </main>
  </body>
</html>
