<% content_for :title, "Taxonomy — #{@site.name}" %>
<% content_for :crumbs do %><%= link_to "Sites", sites_path %> / <%= link_to @site.name, @site %> / Taxonomy<% end %>

<div class="page-head"><h1>Taxonomy</h1></div>
<%= render "shared/site_nav", site: @site %>

<div class="grid cols-3">
  <div class="card">
    <h2>Tags</h2>
    <div class="chip-row">
      <% @tags.each do |tag, n| %>
        <%= link_to "#{tag} (#{n})", site_pages_path(@site, tag: tag), class: "badge" %>
      <% end %>
      <% if @tags.empty? %><p class="faint">None.</p><% end %>
    </div>
  </div>
  <div class="card">
    <h2>Categories</h2>
    <div class="chip-row">
      <% @categories.each do |cat, n| %>
        <%= link_to "#{cat} (#{n})", site_pages_path(@site, category: cat), class: "badge" %>
      <% end %>
      <% if @categories.empty? %><p class="faint">None.</p><% end %>
    </div>
  </div>
  <div class="card">
    <h2>Authors</h2>
    <div class="chip-row">
      <% @authors.each do |author, n| %>
        <%= link_to "#{author} (#{n})", site_pages_path(@site, author: author), class: "badge" %>
      <% end %>
      <% if @authors.empty? %><p class="faint">None.</p><% end %>
    </div>
  </div>
</div>
