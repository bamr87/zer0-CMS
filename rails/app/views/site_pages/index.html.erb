<% content_for :title, "Content — #{@site.name}" %>
<% content_for :crumbs do %><%= link_to "Sites", sites_path %> / <%= link_to @site.name, @site %> / Content<% end %>
<% content_for :topbar_actions do %>
  <%= link_to "＋ New page", new_site_page_path(@site, collection: @collection), class: "btn primary" %>
<% end %>

<div class="page-head"><h1>Content</h1></div>
<%= render "shared/site_nav", site: @site %>

<% if @scan_error %>
  <div class="flash alert"><%= @scan_error %></div>
<% else %>
  <% if @catalog.collections.size > 1 %>
    <div class="chip-row">
      <%= link_to "all", site_pages_path(@site, q: @q, status: @status), class: "badge #{@collection.blank? ? "ok" : ""}" %>
      <% @catalog.collections.each do |name| %>
        <%= link_to name, site_pages_path(@site, collection: name, q: @q, status: @status), class: "badge #{@collection == name ? "ok" : ""}" %>
      <% end %>
    </div>
  <% end %>
  <div class="chip-row">
    <%= link_to "all statuses", site_pages_path(@site, collection: @collection, q: @q), class: "badge #{@status.blank? ? "ok" : ""}" %>
    <%= link_to "live", site_pages_path(@site, collection: @collection, q: @q, status: "live"), class: "badge #{@status == "live" ? "ok" : ""}" %>
    <%= link_to "drafts", site_pages_path(@site, collection: @collection, q: @q, status: "draft"), class: "badge #{@status == "draft" ? "ok" : ""}" %>
  </div>

  <%= form_with url: site_pages_path(@site), method: :get, class: "filter-bar" do %>
    <%= hidden_field_tag :collection, @collection if @collection.present? %>
    <%= hidden_field_tag :status, @status if @status.present? %>
    <%= search_field_tag :q, @q, placeholder: "Search title, path, author…" %>
    <%= submit_tag "Search", class: "btn sm" %>
  <% end %>

  <% if @entries.any? %>
    <div class="card pad-0">
      <table class="list">
        <thead><tr><th></th><th>Title</th><th>Collection</th><th>Author</th><th>Status</th></tr></thead>
        <tbody>
          <% @entries.each do |entry| %>
            <% url = item_site_pages_path(@site, file: entry.relative) %>
            <tr>
              <td style="width:88px;">
                <% thumb = preview_url(@site, entry) %>
                <% if thumb %>
                  <%= link_to url do %><span class="preview-frame thumb"><img src="<%= thumb %>" alt="" loading="lazy"></span><% end %>
                <% end %>
              </td>
              <td>
                <%= link_to entry.title, url %>
                <div class="faint mono" style="font-size:.76rem;"><%= entry.relative %></div>
              </td>
              <td class="mono faint"><%= entry.collection %></td>
              <td class="faint"><%= entry.author.presence || "—" %></td>
              <td><span class="badge <%= entry.draft ? "warn" : "ok" %>"><%= entry.draft ? "draft" : (entry.status.presence || "live") %></span></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
  <% else %>
    <div class="empty"><div class="big">▤</div>No files match this filter. <%= link_to "Create one", new_site_page_path(@site) %>.</div>
  <% end %>
<% end %>
