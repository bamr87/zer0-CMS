# frozen_string_literal: true

# The zer0-CMS Rails app: the fleet CMS on Administrate (RFC §2-§3). The
# content library under lib/zer0_cms is stdlib-only and needs none of these
# gems; bin/zer0-cms and bin/test-stdlib run on plain Ruby without bundler.
source "https://rubygems.org"

ruby file: ".ruby-version"

gem "rails", "~> 8.1.3"
gem "propshaft"
gem "importmap-rails"
gem "turbo-rails"
gem "stimulus-rails"
gem "sqlite3", ">= 2.1"
gem "puma", ">= 5.0"

# The admin framework: dashboards, search, filters, pagination, custom fields.
gem "administrate", "~> 1.0"

# Markdown preview in the page editor.
gem "kramdown", "~> 2.5"
gem "kramdown-parser-gfm"

# The image engine. Loaded on demand by the image-engine bridge, never at boot
# (it depends on Jekyll, which a web app has no business loading eagerly).
gem "zer0-image-generator", "~> 0.6", require: false

group :test do
  gem "minitest"
end
