# frozen_string_literal: true

# The zer0-CMS content-engine web app. The engine itself (lib/zer0_cms) is
# stdlib-only and needs no gems; these are only for the optional Rails web
# wizard. The headless CLI (bin/zer0-cms) and the test suite run on plain Ruby.
source "https://rubygems.org"

ruby ">= 3.2"

gem "rails", "~> 7.1"
gem "puma", "~> 6.4"

group :development, :test do
  gem "minitest", "~> 5.20"
end
