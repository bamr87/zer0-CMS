# The compose stack's environment (docker-compose.yml reads every key; copy to
# .env — gitignored — and fill in what you use). The keys a local `runserver`
# of the platform reads are listed in content/.env.example instead; compose
# sets those itself.

# ── Ports (every service is published on 127.0.0.1 only) ───────────────────
IMAGEGEN_PORT=3000         # the image generator's panel (--profile imagegen)
CONTENT_PORT=8000          # the platform (--profile content)

# ── Sites: the checkout mounted at /sites in every container ───────────────
SITES_DIR=.

# ── The platform ───────────────────────────────────────────────────────────
CONTENT_SECRET_KEY=change-me-in-production
POSTGRES_PASSWORD=zer0
LOG_FORMAT=json            # json | text (content/ops/README.md)
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=      # comma-separated browser origins that may call /api/, /graphql/, /mcp/
SENTRY_DSN=                # error reporting is off until set
# What /version reports; set by the image build (GIT_SHA=$(git rev-parse --short HEAD)).
GIT_SHA=
BUILT_AT=
# Models: recorded (fixtures, no network) | fake | litellm (needs provider keys).
LLM_BACKEND=recorded
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
# Distribution (docs/DISTRIBUTION.md): the LinkedIn app connects a channel, which then
# publishes with its own token; nothing goes out to a kind unless its switch is 1 and a
# person armed the channel.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
ZER0_CMS_LINKEDIN_REDIRECT_URI=
ZER0_LINKEDIN_PUBLISH=
ZER0_WORDPRESS_PUBLISH=
ZER0_GITHUB_PR_PUBLISH=
ZER0_EMAIL_PUBLISH=

# Accounts (content/accounts/README.md): set these in the content service's environment for a deployment
# that opens sign-up or signs in through an IdP or GitHub (content/.env.example lists every one).
# SIGNUP_OPEN, ACCOUNT_EMAIL_VERIFICATION, OIDC_PROVIDERS and OIDC_<ID>_*, OIDC_GROUP_MAP,
# GITHUB_LOGIN_CLIENT_ID, GITHUB_LOGIN_CLIENT_SECRET

# ── The image generator's panel (--profile imagegen) ───────────────────────
OPENAI_API_KEY=
XAI_API_KEY=
XAI_OAUTH_TOKEN=
STABILITY_API_KEY=
GEMINI_API_KEY=
