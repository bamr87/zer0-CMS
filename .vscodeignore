# What NEVER goes into the vsix.
#
# The package is built with `--no-dependencies`: esbuild bundles everything into
# `dist/`, so no `node_modules` tree is folded in and nothing is ever unignored
# back out of one. `media/**` ships (the webviews load their CSS and the codicon
# font from the extension root at runtime) — including `media/templates/**`,
# the vendored ai-runner lane template the Harness route reads from disk.
#
# The committed `.vsix-manifest.txt` is the expected result of this file; CI
# diffs `vsce ls` against it, so a change here is a reviewed change.
.vscode/**
.vscode-test/**
.vscode-test.mjs
.github/**
src/**
out/**
rails/**
tools/**
docs/**
node_modules/**

**/*.ts
**/*.map
**/tsconfig.json
esbuild.js
eslint.config.mjs
.editorconfig
.prettierrc
.gitignore
.env
*.vsix
test-runner.js

# The rest of the zer0 stack, imported into this repository (docs/MONOREPO.md):
# the theme, the image generator, the sites and the apps are their own
# deliverables.
packages/**
sites/**
apps/**
.gitmodules
# The content plane (docs/adr/0001-target-architecture.md) and the shared
# schemas it owns. Only schemas/zer0.schema.json ships in the vsix.
content/**
schemas/events/**
schemas/graphql/**
schemas/content/**
.markdownlint-cli2.jsonc
# The workspace registry and its command (tools/** above holds the library).
workspace.yml
bin/**

# The Rails half's container definition: repository infrastructure, not payload.
docker-compose.yml

# Release plumbing and toolchain pins: repository infrastructure, not payload.
release-please-config.json
.release-please-manifest.json
.vsix-manifest.txt
.nvmrc

# This repository's own fleet manifest is documentation, not payload. The Fleet
# console always reads the *workspace's* `fleet.manifest.yml` (resolved from
# `zer0Cms.fleet.manifestPath` against the open folder) and never a file inside
# the extension install directory — `context.extensionUri` is used only for
# `media/` and `dist/` webview resources.
fleet.manifest.yml

# Agent guidance and per-directory notes are for contributors, not users.
# The root README is the marketplace description and must stay.
AGENTS.md
CLAUDE.md
media/README.md
media/templates/README.md

# Repository infrastructure that lives at the root but is not extension payload:
# the agent kit and the verification kit (the verifier agent, the verify-feature
# skill, the feature index, the scenarios), the hooks, the security policy, the
# root env template, the platform OpenAPI document, and the page-feedback widget
# the hub vendors into media/ for its parity check (nothing in the extension
# loads it).
.claude/**
features/**
verify/**
.pre-commit-config.yaml
.env.example
SECURITY.md
schemas/openapi/**
media/fleet-feedback.js
media/fleet-feedback-capture.js
# Local caches a checkout may carry; CI never has them, so they must not change the list.
.ruff_cache/**
.frontmatter/**
