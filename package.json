{
  "name": "zer0-cms",
  "displayName": "zer0-CMS",
  "description": "A lightweight, governed CMS for your markdown repo — metadata panel, content dashboard, brand guard, human approval, and an idempotency ledger. Zero runtime dependencies.",
  "version": "0.1.0",
  "preview": true,
  "publisher": "bamr87",
  "author": "bamr87",
  "license": "MIT",
  "icon": "media/zer0-cms-128.png",
  "galleryBanner": {
    "color": "#0A1A20",
    "theme": "dark"
  },
  "homepage": "https://github.com/bamr87/zer0-CMS",
  "bugs": {
    "url": "https://github.com/bamr87/zer0-CMS/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bamr87/zer0-CMS.git"
  },
  "contributors": [
    "Elio Struyf <elio@struyfconsulting.be> (https://www.eliostruyf.com) — author of Front Matter CMS, from which zer0-CMS's UI conventions derive"
  ],
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "cms",
    "markdown",
    "front matter",
    "jekyll",
    "static site",
    "ai"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/zer0.json",
    "workspaceContains:**/.zer0/config.json"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "zer0-cms",
          "title": "zer0-CMS",
          "icon": "media/zer0-cms-activity.svg"
        }
      ]
    },
    "views": {
      "zer0-cms": [
        {
          "id": "zer0Cms.panel",
          "name": "Metadata",
          "type": "webview"
        },
        {
          "id": "zer0Cms.content",
          "name": "Content"
        },
        {
          "id": "zer0Cms.drafts",
          "name": "Drafts",
          "when": "zer0Cms:governance:enabled"
        },
        {
          "id": "zer0Cms.catering",
          "name": "Distribution",
          "when": "zer0Cms:contract:present"
        },
        {
          "id": "zer0Cms.published",
          "name": "Published",
          "when": "zer0Cms:governance:enabled"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "zer0Cms.content",
        "contents": "No zer0.json was found in this workspace.\n[Initialize project](command:zer0Cms.init)",
        "when": "!zer0Cms:enabled"
      }
    ],
    "commands": [
      {
        "command": "zer0Cms.init",
        "title": "Initialize project",
        "category": "zer0-CMS"
      },
      {
        "command": "zer0Cms.dashboard",
        "title": "Open dashboard",
        "category": "zer0-CMS",
        "icon": "$(dashboard)"
      },
      {
        "command": "zer0Cms.dashboard.close",
        "title": "Close dashboard",
        "category": "zer0-CMS",
        "icon": "$(close)"
      },
      {
        "command": "zer0Cms.refresh",
        "title": "Refresh content index",
        "category": "zer0-CMS",
        "icon": "$(refresh)"
      },
      {
        "command": "zer0Cms.cache.clear",
        "title": "Clear cache",
        "category": "zer0-CMS"
      },
      {
        "command": "zer0Cms.showOutput",
        "title": "Show output channel",
        "category": "zer0-CMS"
      },
      {
        "command": "zer0Cms.registerFolder",
        "title": "Register content folder",
        "category": "zer0-CMS"
      },
      {
        "command": "zer0Cms.unregisterFolder",
        "title": "Unregister content folder",
        "category": "zer0-CMS"
      },
      {
        "command": "zer0Cms.createContent",
        "title": "Create content",
        "category": "zer0-CMS",
        "icon": "$(add)"
      },
      {
        "command": "zer0Cms.createContentInFolder",
        "title": "Create content here",
        "category": "zer0-CMS"
      },
      {
        "command": "zer0Cms.generateSlug",
        "title": "Generate slug",
        "category": "zer0-CMS"
      },
      {
        "command": "zer0Cms.setLastModified",
        "title": "Set last-modified date",
        "category": "zer0-CMS"
      },
      {
        "command": "zer0Cms.insertImage",
        "title": "Insert image",
        "category": "zer0-CMS",
        "icon": "$(device-camera)"
      },
      {
        "command": "zer0Cms.openFile",
        "title": "Open file",
        "category": "zer0-CMS"
      },
      {
        "command": "zer0Cms.collapseSections",
        "title": "Collapse all sections",
        "category": "zer0-CMS",
        "icon": "$(collapse-all)"
      },
      {
        "command": "zer0Cms.focusTags",
        "title": "Focus tags field",
        "category": "zer0-CMS"
      },
      {
        "command": "zer0Cms.focusCategories",
        "title": "Focus categories field",
        "category": "zer0-CMS"
      },
      {
        "command": "zer0Cms.contentType.generate",
        "title": "Generate content type from file",
        "category": "zer0-CMS"
      },
      {
        "command": "zer0Cms.contentType.addMissingFields",
        "title": "Add missing fields",
        "category": "zer0-CMS"
      },
      {
        "command": "zer0Cms.contentType.set",
        "title": "Set content type",
        "category": "zer0-CMS"
      },
      {
        "command": "zer0Cms.draft.new",
        "title": "New draft from content",
        "category": "zer0-CMS",
        "icon": "$(new-file)"
      },
      {
        "command": "zer0Cms.draft.review",
        "title": "Review draft",
        "category": "zer0-CMS",
        "icon": "$(preview)"
      },
      {
        "command": "zer0Cms.draft.approve",
        "title": "Approve draft",
        "category": "zer0-CMS",
        "icon": "$(check)"
      },
      {
        "command": "zer0Cms.draft.publish",
        "title": "Publish draft",
        "category": "zer0-CMS",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "zer0Cms.draft.guard",
        "title": "Run brand guard",
        "category": "zer0-CMS",
        "icon": "$(shield)"
      },
      {
        "command": "zer0Cms.draft.preview",
        "title": "Show publish preview",
        "category": "zer0-CMS"
      },
      {
        "command": "zer0Cms.catering.worklist",
        "title": "Generate distribution worklist",
        "category": "zer0-CMS",
        "icon": "$(list-ordered)"
      },
      {
        "command": "zer0Cms.contract.run",
        "title": "Run CMS engine",
        "category": "zer0-CMS",
        "icon": "$(play)"
      },
      {
        "command": "zer0Cms.contract.normalizePreview",
        "title": "Normalize front matter (preview)",
        "category": "zer0-CMS"
      },
      {
        "command": "zer0Cms.contract.normalizeApply",
        "title": "Normalize front matter (apply)",
        "category": "zer0-CMS"
      },
      {
        "command": "zer0Cms.agent.open",
        "title": "Open AI agent",
        "category": "zer0-CMS",
        "icon": "$(sparkle)"
      },
      {
        "command": "zer0Cms.agent.start",
        "title": "Start AI agent",
        "category": "zer0-CMS"
      },
      {
        "command": "zer0Cms.agent.stop",
        "title": "Stop AI agent",
        "category": "zer0-CMS",
        "icon": "$(debug-stop)"
      },
      {
        "command": "zer0Cms.mcp.writeWorkspaceConfig",
        "title": "Write .vscode/mcp.json",
        "category": "zer0-CMS"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "zer0Cms.createContentInFolder",
          "when": "false"
        },
        {
          "command": "zer0Cms.openFile",
          "when": "false"
        },
        {
          "command": "zer0Cms.draft.approve",
          "when": "zer0Cms:governance:enabled"
        },
        {
          "command": "zer0Cms.draft.publish",
          "when": "zer0Cms:governance:enabled"
        },
        {
          "command": "zer0Cms.draft.review",
          "when": "zer0Cms:governance:enabled"
        },
        {
          "command": "zer0Cms.draft.guard",
          "when": "zer0Cms:governance:enabled"
        },
        {
          "command": "zer0Cms.draft.preview",
          "when": "zer0Cms:governance:enabled"
        },
        {
          "command": "zer0Cms.generateSlug",
          "when": "zer0Cms:file:isValid"
        },
        {
          "command": "zer0Cms.setLastModified",
          "when": "zer0Cms:file:isValid"
        },
        {
          "command": "zer0Cms.insertImage",
          "when": "zer0Cms:file:isValid"
        },
        {
          "command": "zer0Cms.contentType.generate",
          "when": "zer0Cms:file:isValid"
        },
        {
          "command": "zer0Cms.contentType.set",
          "when": "zer0Cms:file:isValid"
        },
        {
          "command": "zer0Cms.contentType.addMissingFields",
          "when": "zer0Cms:file:isValid"
        },
        {
          "command": "zer0Cms.agent.open",
          "when": "zer0Cms:agent:enabled"
        },
        {
          "command": "zer0Cms.agent.start",
          "when": "zer0Cms:agent:enabled"
        },
        {
          "command": "zer0Cms.agent.stop",
          "when": "zer0Cms:agent:running"
        }
      ],
      "editor/title": [
        {
          "command": "zer0Cms.dashboard",
          "group": "navigation@1",
          "when": "zer0Cms:enabled && !zer0Cms:dashboard:open"
        },
        {
          "command": "zer0Cms.insertImage",
          "group": "navigation@2",
          "when": "zer0Cms:file:isValid"
        }
      ],
      "view/title": [
        {
          "command": "zer0Cms.collapseSections",
          "when": "view == zer0Cms.panel",
          "group": "navigation"
        },
        {
          "command": "zer0Cms.refresh",
          "when": "view =~ /^zer0Cms\\.(content|drafts|catering|published)$/",
          "group": "navigation"
        },
        {
          "command": "zer0Cms.createContent",
          "when": "view == zer0Cms.content",
          "group": "navigation"
        },
        {
          "command": "zer0Cms.catering.worklist",
          "when": "view == zer0Cms.catering",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "zer0Cms.draft.review",
          "when": "view == zer0Cms.drafts && viewItem =~ /^draft-/",
          "group": "inline@1"
        },
        {
          "command": "zer0Cms.draft.approve",
          "when": "view == zer0Cms.drafts && viewItem == draft-pending",
          "group": "inline@2"
        },
        {
          "command": "zer0Cms.draft.publish",
          "when": "view == zer0Cms.drafts && viewItem =~ /^draft-(pending|approved)$/",
          "group": "inline@3"
        },
        {
          "command": "zer0Cms.draft.guard",
          "when": "view == zer0Cms.drafts && viewItem =~ /^draft-/",
          "group": "1_draft@1"
        },
        {
          "command": "zer0Cms.draft.preview",
          "when": "view == zer0Cms.drafts && viewItem =~ /^draft-/",
          "group": "1_draft@2"
        },
        {
          "command": "zer0Cms.draft.new",
          "when": "view == zer0Cms.content && viewItem =~ /^content-article/",
          "group": "inline@1"
        },
        {
          "command": "zer0Cms.draft.new",
          "when": "view == zer0Cms.catering && viewItem == catering-item",
          "group": "inline@1"
        }
      ],
      "explorer/context": [
        {
          "command": "zer0Cms.registerFolder",
          "when": "explorerResourceIsFolder && zer0Cms:enabled && !zer0Cms:folder:registered",
          "group": "zer0cms@1"
        },
        {
          "command": "zer0Cms.unregisterFolder",
          "when": "explorerResourceIsFolder && zer0Cms:folder:registered",
          "group": "zer0cms@1"
        },
        {
          "command": "zer0Cms.createContentInFolder",
          "when": "explorerResourceIsFolder && zer0Cms:enabled",
          "group": "zer0cms@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "zer0Cms.dashboard",
        "key": "alt+d",
        "mac": "alt+d",
        "when": "zer0Cms:enabled"
      },
      {
        "command": "zer0Cms.insertImage",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i",
        "when": "zer0Cms:file:isValid && editorTextFocus"
      },
      {
        "command": "zer0Cms.draft.review",
        "key": "alt+r",
        "mac": "alt+r",
        "when": "zer0Cms:governance:enabled"
      },
      {
        "command": "zer0Cms.createContent",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "zer0Cms:enabled"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          "zer0.json",
          ".zer0/config.json"
        ],
        "url": "./schemas/zer0.schema.json"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "zer0Cms.mcp",
        "label": "zer0-CMS"
      }
    ],
    "configuration": {
      "title": "zer0-CMS",
      "properties": {
        "zer0Cms.configFile": {
          "type": "string",
          "default": "zer0.json",
          "scope": "resource",
          "markdownDescription": "Workspace-relative path of the project configuration file. The project *schema* — content folders, content types, taxonomy, SEO thresholds — lives there, not in VS Code settings."
        },
        "zer0Cms.panel.openOnSupportedFile": {
          "type": "boolean",
          "default": false,
          "description": "Reveal the zer0-CMS panel automatically when a supported content file is opened."
        },
        "zer0Cms.panel.freeformTaxonomy": {
          "type": "boolean",
          "default": true,
          "description": "Allow tags and categories that are not yet in the project taxonomy to be created from the panel."
        },
        "zer0Cms.panel.sections": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "governance",
              "metadata",
              "seo",
              "actions",
              "recent",
              "settings",
              "other"
            ]
          },
          "default": [
            "governance",
            "metadata",
            "seo",
            "actions",
            "recent",
            "other"
          ],
          "description": "Which panel sections to render, in order."
        },
        "zer0Cms.dashboard.openOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "Open the dashboard when the workspace loads."
        },
        "zer0Cms.dashboard.defaultView": {
          "type": "string",
          "enum": [
            "grid",
            "list",
            "structure"
          ],
          "default": "grid",
          "description": "Initial layout of the dashboard Contents view."
        },
        "zer0Cms.dashboard.defaultSorting": {
          "type": "string",
          "enum": [
            "LastModifiedDesc",
            "LastModifiedAsc",
            "FileNameAsc",
            "FileNameDesc",
            "PublishedDesc",
            "PublishedAsc"
          ],
          "default": "LastModifiedDesc",
          "description": "Initial sort order of the dashboard Contents view."
        },
        "zer0Cms.dashboard.pageSize": {
          "type": "number",
          "default": 16,
          "minimum": 0,
          "maximum": 52,
          "description": "Items per page in the dashboard Contents view. 0 disables pagination."
        },
        "zer0Cms.dashboard.cardFields": {
          "type": "object",
          "default": {
            "state": true,
            "date": true
          },
          "description": "Which optional fields a content card shows."
        },
        "zer0Cms.content.autoUpdateModifiedDate": {
          "type": "boolean",
          "default": false,
          "description": "Stamp the content type's modified-date field on every save."
        },
        "zer0Cms.content.preserveCasing": {
          "type": "boolean",
          "default": false,
          "description": "Keep the original casing when generating a slug."
        },
        "zer0Cms.content.defaultFileType": {
          "type": "string",
          "default": "md",
          "description": "Extension used for newly created content."
        },
        "zer0Cms.content.supportedFileTypes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "md",
            "mdx",
            "markdown"
          ],
          "description": "File extensions zer0-CMS treats as content."
        },
        "zer0Cms.content.publicFolder": {
          "type": "string",
          "default": "",
          "description": "Workspace-relative folder served at the site root — used to resolve image paths."
        },
        "zer0Cms.date.format": {
          "type": "string",
          "default": "yyyy-MM-dd",
          "markdownDescription": "Date format for front-matter date fields. Tokens: `yyyy MM dd HH hh mm ss aaa`."
        },
        "zer0Cms.date.timezone": {
          "type": "string",
          "default": "UTC",
          "description": "IANA timezone used when formatting and parsing dates."
        },
        "zer0Cms.seo.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the SEO insights section in the panel."
        },
        "zer0Cms.validation.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Report missing required fields as diagnostics in the Problems panel."
        },
        "zer0Cms.governance.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the governed draft queue: draft, brand guard, human approval, publish, ledger."
        },
        "zer0Cms.governance.draftsFolder": {
          "type": "string",
          "default": ".zer0/drafts",
          "description": "Workspace-relative folder holding the governed draft queue."
        },
        "zer0Cms.governance.ledgerPath": {
          "type": "string",
          "default": ".zer0/ledger.json",
          "description": "Workspace-relative path of the idempotency ledger."
        },
        "zer0Cms.governance.acceptStatuses": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "pending",
              "approved"
            ]
          },
          "default": [
            "pending",
            "approved"
          ],
          "markdownDescription": "Draft statuses the publish path accepts. Restrict to `[\"approved\"]` to require the in-editor approval step."
        },
        "zer0Cms.governance.publishAllow": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Master switch. While this is off, publishing is blocked in the panel, the dashboard, the command palette **and** the bundled MCP server."
        },
        "zer0Cms.governance.bannedPatternsFile": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional workspace-relative JSON file of extra brand-guard patterns: `[{\"name\", \"pattern\", \"flags\"?, \"level\"?}]`."
        },
        "zer0Cms.governance.target": {
          "type": "string",
          "default": "jekyll",
          "description": "Publish target that turns an approved draft into published content."
        },
        "zer0Cms.cms.root": {
          "type": "string",
          "default": ".cms",
          "description": "Workspace-relative root of the .cms/ contract emitted by the content engine."
        },
        "zer0Cms.cms.pythonPath": {
          "type": "string",
          "default": "python3",
          "scope": "machine-overridable",
          "description": "Python interpreter used to run the content engine."
        },
        "zer0Cms.cms.engineScript": {
          "type": "string",
          "default": "scripts/cms/cms.py",
          "description": "Workspace-relative path of the content engine script."
        },
        "zer0Cms.cms.normalizerScript": {
          "type": "string",
          "default": "scripts/content/normalize-frontmatter.py",
          "description": "Workspace-relative path of the mechanical front-matter normalizer."
        },
        "zer0Cms.cms.contentDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "pages/"
          ],
          "description": "Directories the content engine scans."
        },
        "zer0Cms.agent.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Enable the optional AI agent. Requires the `@anthropic-ai/claude-agent-sdk` optional dependency and a Claude credential."
        },
        "zer0Cms.agent.model": {
          "type": "string",
          "default": "claude-opus-5",
          "description": "Model the AI agent runs on."
        },
        "zer0Cms.agent.maxTurns": {
          "type": "number",
          "default": 40,
          "minimum": 1,
          "description": "Maximum agent turns per run."
        },
        "zer0Cms.agent.permissionMode": {
          "type": "string",
          "enum": [
            "default",
            "acceptEdits",
            "plan"
          ],
          "default": "default",
          "description": "Agent permission mode. 'default' routes every mutating tool through an approve/deny gate."
        },
        "zer0Cms.logging.level": {
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info",
            "verbose"
          ],
          "default": "info",
          "description": "Verbosity of the zer0-CMS output channel."
        }
      }
    },
    "configurationDefaults": {
      "files.associations": {
        "zer0.json": "jsonc"
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "watch": "npm-run-all -p watch:esbuild watch:tsc",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "compile-tests": "tsc -p . --outDir out",
    "pretest": "npm run compile-tests && npm run compile",
    "test": "node test-runner.js"
  },
  "dependencies": {},
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.181"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.1",
    "@types/vscode": "^1.101.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  }
}
