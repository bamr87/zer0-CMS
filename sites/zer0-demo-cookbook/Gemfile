source "https://rubygems.org"

# Current Jekyll + the remote-theme plugin (loads bamr87/zer0-mistakes from GitHub).
gem "jekyll", "~> 4.3"
gem "jekyll-remote-theme"

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-sitemap"
  gem "jekyll-seo-tag"
  gem "jekyll-include-cache"
  gem "jekyll-paginate"
end

# Ruby 3+ no longer bundles webrick (needed by `jekyll serve`).
gem "webrick", "~> 1.8"

platforms :windows, :jruby do
  gem "tzinfo"
  gem "tzinfo-data"
end
