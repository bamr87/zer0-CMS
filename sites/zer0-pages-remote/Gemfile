source "https://rubygems.org"

# ==============================================================================
# GitHub Pages parity Gemfile
# ==============================================================================
#
# Originally emitted by the zer0-mistakes installer's macOS/Ruby-2.6 branch
# (templates/config/Gemfile.macos.template) and kept, deliberately, because the
# `github-pages` gem is what this site actually publishes with: the repo has no
# deploy workflow, so GitHub Pages builds it natively — in SAFE MODE, on the
# github-pages toolchain (the live site reports `Jekyll v3.10.0`). Local dev
# (docker-compose.yml, ruby:3.2-slim) and CI therefore use the same gem so what
# you see locally is what GitHub publishes.
#
# The version caps below originate from that Ruby-2.6 branch; the environments
# this repo actually runs in are Ruby 3.x, so the caps are no longer required
# for compatibility — they are simply not being changed here, since bumping the
# github-pages toolchain is a separate decision from documenting it.
#
# Do NOT swap this for the theme's Jekyll-4 remote template
# (templates/config/Gemfile.remote.template): that one is for consumers whose
# deploy workflow builds with Bundler. This site is built by GitHub, not by us.
# Background on the theme's pinning policy:
# https://github.com/bamr87/zer0-mistakes/blob/main/docs/systems/ZERO_PIN_STRATEGY.md
# ==============================================================================

# GitHub Pages gem includes Jekyll and compatible plugins.
gem "github-pages", ">= 228", "< 232", group: :jekyll_plugins

# Essential plugins (already included in github-pages but listed for clarity).
#
# INVARIANT: every plugin named here must ALSO appear under `plugins:` in
# _config.yml. The github-pages gem runs Jekyll in safe mode, where only
# whitelisted plugins named in `plugins:` are ever registered — a gem present
# here but missing there is dead weight at best and a build failure at worst.
# That is exactly how the "Unknown tag 'include_cached'" outage happened (#8).
gem "jekyll-remote-theme"
gem "jekyll-feed"
gem "jekyll-sitemap"
gem "jekyll-seo-tag"
# Provides the {% include_cached %} tag that the zer0-mistakes remote theme's
# _layouts/root.html depends on.
gem "jekyll-include-cache"

# Platform compatibility and performance
gem "ffi", "~> 1.17.0"
gem "webrick", "~> 1.7"

# CommonMarker for Markdown processing.
# Cap to ~> 0.23: commonmarker 1.x requires Ruby >= 3.1
gem "commonmarker", "~> 0.23"
