# frozen_string_literal: true

source "https://rubygems.org"

# GitHub Pages parity: Jekyll 3.10 + the Pages plugin whitelist
# (includes jekyll-remote-theme, which resolves the zer0-mistakes theme
# declared in _config.yml at build time).
#
# ">= 228" is the floor sites/zer0-pages-remote and the theme's own Gemfile
# use: github-pages 228 is the first release whose Liquid (4.0.4) runs on
# Ruby 3.2+. Anything older pins Liquid 4.0.3, which calls the removed
# String#tainted? while rendering and fails every page with
# "undefined method 'tainted?'". Gemfile.lock is gitignored here, so the
# floor has to live in the Gemfile.
gem "github-pages", ">= 228", group: :jekyll_plugins

# AI preview banners: adds `bundle exec jekyll preview-images` (script-driven,
# never part of `jekyll build`). Renderer credential: OPENAI_API_KEY.
# Configured under `preview_images:` in _config.yml.
gem "zer0-image-generator", group: :jekyll_plugins

# Local theme development against a sibling checkout (needed while theme
# changes are unreleased):
#   ZER0_THEME_LOCAL=../../packages/zer0-mistakes bundle install
#   bundle exec jekyll serve --config _config.yml,_config_dev.yml
gem "jekyll-theme-zer0", path: ENV["ZER0_THEME_LOCAL"] if ENV["ZER0_THEME_LOCAL"]

# jekyll serve on Ruby 3.x
gem "webrick", "~> 1.8"
