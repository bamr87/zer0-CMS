# DrSAI Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# LLM Provider Configuration
# =============================================================================

# Which LLM provider to use: openai, anthropic, xai, or mock
DRSAI_LLM_PROVIDER=xai

# OpenAI API Key (required if using openai provider)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API Key (required if using anthropic provider)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# xAI API Key (required if using xai provider) - for Grok models
XAI_API_KEY=your-xai-api-key-here

# =============================================================================
# Model Configuration
# =============================================================================

# OpenAI model to use (default: gpt-4o)
DRSAI_OPENAI_MODEL=gpt-4o

# Anthropic model to use (default: claude-sonnet-4-20250514)
DRSAI_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# xAI model to use (default: grok-3-latest)
DRSAI_XAI_MODEL=grok-3-latest

# =============================================================================
# Generation Settings
# =============================================================================

# Maximum tokens for generation (default: 2000)
DRSAI_MAX_TOKENS=2000

# Temperature for generation (0.0-2.0, default: 0.8)
DRSAI_TEMPERATURE=0.8

# Request timeout in seconds (default: 30)
DRSAI_TIMEOUT=30

# =============================================================================
# Quality Settings
# =============================================================================

# Target meter compliance (0.0-1.0, default: 0.98)
DRSAI_METER_TARGET=0.98

# Minimum acceptable meter compliance (0.0-1.0, default: 0.95)
DRSAI_METER_MINIMUM=0.95

# Maximum regeneration attempts (1-5, default: 3)
DRSAI_MAX_ATTEMPTS=3

# =============================================================================
# Output Settings
# =============================================================================

# Enable verbose output (true/false, default: false)
DRSAI_VERBOSE=false

