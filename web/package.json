{
  "name": "@zer0/web",
  "private": true,
  "version": "0.0.0",
  "description": "zer0-CMS's one React frontend: the studio (studio/) and the shared packages its workspaces are built from and the extension's webviews will render (packages/).",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "studio"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "npm run dev -w @zer0/studio",
    "build": "npm run build -w @zer0/studio",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "gen": "npm run gen -w @zer0/api",
    "check:api": "npm run check -w @zer0/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
