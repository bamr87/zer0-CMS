{
  // One strict TypeScript project for the whole workspace: the packages are
  // consumed from source (each package.json exports its src/), so one
  // `tsc --noEmit -p .` checks the studio, the packages and the tests together.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"]
  },
  "include": ["packages/*/src", "packages/*/test", "studio/src", "studio/test", "test", "*.ts", "studio/*.ts"]
}
